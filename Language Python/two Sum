#problem= https://leetcode.com/problems/two-sum/

class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        hashMap = {}

        for i, n in enumerate(nums): //i is the current index whereas n is the current number
            diff = target - n
            if diff in hashMap:
                return [hashMap[diff], i] //returns the index of the two elements
            hashMap[n] = i
        return
